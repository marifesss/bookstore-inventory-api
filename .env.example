# Copiar a .env y ajustar. Los valores de ejemplo funcionan tal cual con Docker.

# --- Base de datos ---
POSTGRES_USER=bookstore
POSTGRES_PASSWORD=bookstore
POSTGRES_DB=bookstore

# Puerto en el que la base queda expuesta en el host. No es 5432 por defecto
# porque ese puerto suele estar ocupado por una instalacion nativa de Postgres.
DB_PORT=5433

# Conexion desde el host (Prisma CLI, `npm run start:dev` sin Docker).
# Con `docker compose up` este valor se sobrescribe en docker-compose.yml:
# el host pasa a ser `db` y el puerto 5432, que es la red interna de compose.
DATABASE_URL=postgresql://bookstore:bookstore@localhost:5433/bookstore?schema=public

# --- API ---
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- Reglas de negocio ---
LOCAL_CURRENCY=EUR
DEFAULT_MARGIN_PERCENTAGE=40

# --- Integracion de tasas de cambio ---
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/USD
EXCHANGE_RATE_FALLBACK=0.85
EXCHANGE_RATE_TIMEOUT_MS=5000

# --- Frontend ---
# Lo consume el navegador, por eso apunta a localhost y no al nombre del servicio.
VITE_API_URL=http://localhost:3000
