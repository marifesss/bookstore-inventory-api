      "name": "CalculoDePrecio",
      "item": [
        {
          "name": "Calculo precio de venta",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  " pm.test(\"200 OK\", () => pm.response.to.have.status(200));\r",
                  "\r",
                  "  pm.test(\"El desglose viene completo\", () => {\r",
                  "    pm.expect(pm.response.json()).to.have.all.keys(\r",
                  "      \"book_id\", \"cost_usd\", \"exchange_rate\", \"cost_local\",\r",
                  "      \"margin_percentage\", \"selling_price_local\", \"currency\",\r",
                  "      \"rate_source\", \"calculation_timestamp\",\r",
                  "    );\r",
                  "  });\r",
                  "\r",
                  "  pm.test(\"La aritmética cuadra\", () => {\r",
                  "    const b = pm.response.json();\r",
                  "    const esperado = Number((b.cost_usd * b.exchange_rate * (1 + b.margin_percentage / 100)).toFixed(2));\r",
                  "    pm.expect(b.selling_price_local).to.eql(esperado);\r",
                  "  });\r",
                  "\r",
                  "  pm.test(\"La tasa viene de la API o del fallback\", () => {\r",
                  "    pm.expect(pm.response.json().rate_source).to.be.oneOf([\"api\", \"fallback\"]);\r",
                  "  });"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
